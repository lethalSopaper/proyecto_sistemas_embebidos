          "format": "table",
          "rawSql": "SELECT COALESCE(\n  SUM(distance_m) * 3.6 /\n    NULLIF(SUM(TIMESTAMPDIFF(MICROSECOND, started_at, finished_at) / 1000000.0), 0),\n  0\n) AS value\nFROM routes\nWHERE finished_at IS NOT NULL\n  AND finished_at > started_at\n  AND distance_m IS NOT NULL;",
