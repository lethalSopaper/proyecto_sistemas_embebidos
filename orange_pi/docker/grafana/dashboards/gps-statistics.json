      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "mariadb-gps"
          },
          "format": "table",
          "rawSql": "WITH ordered_points AS (\n  SELECT p.route_id, p.id, p.recorded_at, p.latitude, p.longitude,\n    LAG(p.recorded_at) OVER (PARTITION BY p.route_id ORDER BY p.recorded_at, p.id) AS previous_recorded_at,\n    LAG(p.latitude) OVER (PARTITION BY p.route_id ORDER BY p.recorded_at, p.id) AS previous_latitude,\n    LAG(p.longitude) OVER (PARTITION BY p.route_id ORDER BY p.recorded_at, p.id) AS previous_longitude\n  FROM route_points p\n  JOIN routes r ON r.id = p.route_id\n  WHERE r.finished_at IS NOT NULL\n), segments AS (\n  SELECT\n    2 * 6371000 * ASIN(SQRT(LEAST(1.0,\n      POWER(SIN(RADIANS(latitude - previous_latitude) / 2), 2) +\n      COS(RADIANS(previous_latitude)) * COS(RADIANS(latitude)) *\n      POWER(SIN(RADIANS(longitude - previous_longitude) / 2), 2)\n    ))) AS distance_m,\n    TIMESTAMPDIFF(MICROSECOND, previous_recorded_at, recorded_at) / 1000000.0 AS elapsed_seconds\n  FROM ordered_points\n  WHERE previous_recorded_at IS NOT NULL\n)\nSELECT COALESCE(MAX(distance_m / elapsed_seconds * 3.6), 0) AS value\nFROM segments\nWHERE elapsed_seconds > 0;",
          "refId": "A"
        }
      ],
      "title": "Velocidad máxima estimada (recepción)",
      "type": "stat"
    },
